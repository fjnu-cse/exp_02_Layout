<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <TextView
        android:id="@+id/calculator_title"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="#018578"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:text="ConstraintLayoutTest"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/input_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="28dp"
        android:text="Input"
        android:textColor="#999999"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/calculator_title"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/calculator_display"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="#BDBA99"
        android:gravity="center_vertical|end"
        android:paddingEnd="12dp"
        android:text="0.0"
        android:textColor="#333333"
        android:textSize="24sp"
        app:layout_constraintTop_toBottomOf="@id/input_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 第 1 行按键：7、8、9、÷ -->
    <TextView
        android:id="@+id/key_7"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:layout_marginStart="11dp"
        android:layout_marginEnd="7dp"
        android:layout_marginTop="52dp"
        android:background="@drawable/bg_calc_key"
        android:gravity="center"
        android:text="7"
        android:textColor="#333333"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/calculator_display"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/key_8"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1" />

    <TextView
        android:id="@+id/key_8"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="7dp"
        android:background="@drawable/bg_calc_key"
        android:gravity="center"
        android:text="8"
        android:textColor="#333333"
        android:textSize="18sp"
        app:layout_constraintTop_toTopOf="@id/key_7"
        app:layout_constraintStart_toEndOf="@id/key_7"
        app:layout_constraintEnd_toStartOf="@id/key_9"
        app:layout_constraintHorizontal_weight="1" />

    <TextView
        android:id="@+id/key_9"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="7dp"
        android:background="@drawable/bg_calc_key"
        android:gravity="center"
        android:text="9"
        android:textColor="#333333"
        android:textSize="18sp"
        app:layout_constraintTop_toTopOf="@id/key_7"
        app:layout_constraintStart_toEndOf="@id/key_8"
        app:layout_constraintEnd_toStartOf="@id/key_divide"
        app:layout_constraintHorizontal_weight="1" />

    <TextView
        android:id="@+id/key_divide"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="11dp"
        android:background="@drawable/bg_calc_key"
        android:gravity="center"
        android:text="÷"
        android:textColor="#333333"
        android:textSize="18sp"
        app:layout_constraintTop_toTopOf="@id/key_7"
        app:layout_constraintStart_toEndOf="@id/key_9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1" />

    <!-- 第 2 行按键：4、5、6、× -->
    <TextView
        android:id="@+id/key_4"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:layout_marginStart="11dp"
        android:layout_marginEnd="7dp"
        android:layout_marginTop="55dp"
        android:background="@drawable/bg_calc_key"
        android:gravity="center"
        android:text="4"
        android:textColor="#333333"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/key_7"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/key_5"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1" />

    <TextView
        android:id="@+id/key_5"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="7dp"
        android:background="@drawable/bg_calc_key"
        android:gravity="center"
        android:text="5"
        android:textColor="#333333"
        android:textSize="18sp"
        app:layout_constraintTop_toTopOf="@id/key_4"
        app:layout_constraintStart_toEndOf="@id/key_4"
        app:layout_constraintEnd_toStartOf="@id/key_6"
        app:layout_constraintHorizontal_weight="1" />

    <TextView
        android:id="@+id/key_6"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="7dp"
        android:background="@drawable/bg_calc_key"
        android:gravity="center"
        android:text="6"
        android:textColor="#333333"
        android:textSize="18sp"
        app:layout_constraintTop_toTopOf="@id/key_4"
        app:layout_constraintStart_toEndOf="@id/key_5"
        app:layout_constraintEnd_toStartOf="@id/key_times"
        app:layout_constraintHorizontal_weight="1" />

    <TextView
        android:id="@+id/key_times"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="11dp"
        android:background="@drawable/bg_calc_key"
        android:gravity="center"
        android:text="×"
        android:textColor="#333333"
        android:textSize="18sp"
        app:layout_constraintTop_toTopOf="@id/key_4"
        app:layout_constraintStart_toEndOf="@id/key_6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1" />

    <!-- 第 3 行按键：1、2、3、+ -->
    <TextView
        android:id="@+id/key_1"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:layout_marginStart="11dp"
        android:layout_marginEnd="7dp"
        android:layout_marginTop="55dp"
        android:background="@drawable/bg_calc_key"
        android:gravity="center"
        android:text="1"
        android:textColor="#333333"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/key_4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/key_2"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1" />

    <TextView
        android:id="@+id/key_2"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="7dp"
        android:background="@drawable/bg_calc_key"
        android:gravity="center"
        android:text="2"
        android:textColor="#333333"
        android:textSize="18sp"
        app:layout_constraintTop_toTopOf="@id/key_1"
        app:layout_constraintStart_toEndOf="@id/key_1"
        app:layout_constraintEnd_toStartOf="@id/key_3"
        app:layout_constraintHorizontal_weight="1" />

    <TextView
        android:id="@+id/key_3"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="7dp"
        android:background="@drawable/bg_calc_key"
        android:gravity="center"
        android:text="3"
        android:textColor="#333333"
        android:textSize="18sp"
        app:layout_constraintTop_toTopOf="@id/key_1"
        app:layout_constraintStart_toEndOf="@id/key_2"
        app:layout_constraintEnd_toStartOf="@id/key_plus"
        app:layout_constraintHorizontal_weight="1" />

    <TextView
        android:id="@+id/key_plus"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="11dp"
        android:background="@drawable/bg_calc_key"
        android:gravity="center"
        android:text="+"
        android:textColor="#333333"
        android:textSize="18sp"
        app:layout_constraintTop_toTopOf="@id/key_1"
        app:layout_constraintStart_toEndOf="@id/key_3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1" />

    <!-- 第 4 行按键：.、0、=、− -->
    <TextView
        android:id="@+id/key_dot"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:layout_marginStart="11dp"
        android:layout_marginEnd="7dp"
        android:layout_marginTop="55dp"
        android:background="@drawable/bg_calc_key"
        android:gravity="center"
        android:text="."
        android:textColor="#333333"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/key_1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/key_0"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1" />

    <TextView
        android:id="@+id/key_0"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="7dp"
        android:background="@drawable/bg_calc_key"
        android:gravity="center"
        android:text="0"
        android:textColor="#333333"
        android:textSize="18sp"
        app:layout_constraintTop_toTopOf="@id/key_dot"
        app:layout_constraintStart_toEndOf="@id/key_dot"
        app:layout_constraintEnd_toStartOf="@id/key_equals"
        app:layout_constraintHorizontal_weight="1" />

    <TextView
        android:id="@+id/key_equals"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="7dp"
        android:background="@drawable/bg_calc_key"
        android:gravity="center"
        android:text="="
        android:textColor="#333333"
        android:textSize="18sp"
        app:layout_constraintTop_toTopOf="@id/key_dot"
        app:layout_constraintStart_toEndOf="@id/key_0"
        app:layout_constraintEnd_toStartOf="@id/key_minus"
        app:layout_constraintHorizontal_weight="1" />

    <TextView
        android:id="@+id/key_minus"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="11dp"
        android:background="@drawable/bg_calc_key"
        android:gravity="center"
        android:text="−"
        android:textColor="#333333"
        android:textSize="18sp"
        app:layout_constraintTop_toTopOf="@id/key_dot"
        app:layout_constraintStart_toEndOf="@id/key_equals"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1" />

</androidx.constraintlayout.widget.ConstraintLayout>